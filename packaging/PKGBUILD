# Maintainer: DevByG <devbyg@users.noreply.github.com>
# Upstream release binary repackaged locally; build from source with cargo
# if you do not trust the prebuilt artifact.

pkgname=mvr
pkgver=0.1.0
pkgrel=1
pkgdesc='batch rename files by regex: dry-run CLI + interactive TUI'
arch=('x86_64')
url='https://github.com/DevByG/mvr'
license=('GPL-3.0-only')
depends=('gcc-libs')
source=("$pkgname-v$pkgver-linux-amd64::$url/releases/download/v$pkgver/$pkgname-v$pkgver-linux-amd64")
sha256sums=('5fde98ac48bf5c08bdd92b1e44ae31cd8a678d693c6685d503d6efe32e300d75')
noextract=("$pkgname-v$pkgver-linux-amd64")

package() {
    install -Dm755 "$srcdir/$pkgname-v$pkgver-linux-amd64" "$pkgdir/usr/bin/$pkgname"
}
